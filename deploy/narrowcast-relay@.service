[Unit]
# Templated relay instance. The instance name is the UDP listen port, e.g.
#   systemctl start narrowcast-relay@8443
# reads /etc/narrowcast-relay/relay-8443.env and listens on 0.0.0.0:8443.
#
# Run as many as you like — one per upstream Pi/SDR — each on its own port,
# all sharing the same TLS cert + domain. Clients pick a stream by dialing
# host:PORT. This avoids any SNI/QUIC L4 proxy: the kernel demuxes by port.
Description=Narrowcast relay server (port %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/narrowcast-relay/relay-%i.env
# %i is the listen port. Ports <1024 need CAP_NET_BIND_SERVICE (the
# narrowcast user is unprivileged); on ports >=1024 the capability is
# simply unused, so granting it unconditionally is harmless.
ExecStart=/usr/local/bin/narrowcast-relay \
    -listen 0.0.0.0:%i \
    -cert /etc/narrowcast-relay/certs/server.crt \
    -key /etc/narrowcast-relay/certs/server.key \
    -uplink-key ${UPLINK_KEY} \
    -password ${CLIENT_PASSWORD}
WorkingDirectory=/etc/narrowcast-relay
Restart=always
RestartSec=3
User=narrowcast
Group=narrowcast
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
