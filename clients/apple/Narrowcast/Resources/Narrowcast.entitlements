<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Keychain access. Without this entitlement, SecItem APIs return
         errSecMissingEntitlement (-34018). -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.pierr3.narrowcast</string>
    </array>

    <!-- iCloud Key-Value Store: small (~1 MB) key/value bag synced across
         the user's signed-in devices. Used to mirror the saved-server list
         and favourites. Passwords sync separately via the Keychain
         (kSecAttrSynchronizable) so they ride iCloud Keychain, not KVS. -->
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)com.pierr3.narrowcast</string>
</dict>
</plist>
